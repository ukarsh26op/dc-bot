# Discord bot token
DISCORD_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE

# Public URL of your Pterodactyl/Panel Codespace
# Example: https://your-panel-xxxxx.app.github.dev
PANEL_URL=https://YOUR-PANEL-URL

# Pterodactyl CLIENT API token
PTERODACTYL_CLIENT_TOKEN=PASTE_CLIENT_API_TOKEN_HERE

# Server identifier shown by Pterodactyl
SERVER_ID=YOUR_SERVER_IDENTIFIER

# Optional: Discord role ID allowed to control the server.
# Leave blank to allow all guild members.
ALLOWED_ROLE_ID=
